RewriteEngine On
RewriteBase /

# Pass HTTP Authorization header through (needed for Bearer/API token auth)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Block direct access to internal application directories
RewriteRule ^(config|includes|pages|database|storage|bootstrap)/ - [F,L]

# Block sensitive files from direct download
<FilesMatch "\.(env|sql|md|log|json|lock|git.*)$">
    Require all denied
</FilesMatch>

Options -Indexes

# If the request maps to a real file/dir inside /public, serve it directly
RewriteCond public%{REQUEST_URI} -f [OR]
RewriteCond public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [QSA,L]

# Everything else goes through the front controller
RewriteRule ^(.*)$ public/index.php [QSA,L]
