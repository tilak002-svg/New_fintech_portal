# Copy this file to .env and fill in real values. Never commit .env.
#
# Running via `docker compose up` (see README §3)? Use DB_HOST=db and
# APP_URL=http://localhost:8080 — that's what docker-compose.yml expects.
# Running PHP natively against your own MySQL install instead? Use
# DB_HOST=127.0.0.1 (or your DB server's address) and whatever port you run on.

APP_NAME="Verapay"
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true

DB_HOST=db
DB_PORT=3306
DB_NAME=verapay
DB_USER=verapay_app
DB_PASS=secretpass

SESSION_LIFETIME_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Signing secret for platform API bearer tokens (config/config.php). Without
# this set, the app silently falls back to a hardcoded, publicly-known
# default — fine for local dev, a real security hole on any deployment
# reachable from the internet. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Rotating this later invalidates every merchant's already-issued token.
PLATFORM_JWT_SECRET=

# 32 random bytes, base64-encoded — encrypts/decrypts payment gateway API
# secrets (includes/gateway_secrets.php). Generate one with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep this only in .env, never in the database or version control. If you
# rotate it, every previously-stored gateway secret becomes undecryptable.
GATEWAY_ENCRYPTION_KEY=
